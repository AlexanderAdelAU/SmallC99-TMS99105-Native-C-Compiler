R0	EQU 0
R1	EQU 1
R2	EQU 2
R3	EQU 3
R4	EQU 4
R5	EQU 5
R6	EQU 6
R7	EQU 7
R8	EQU 8
SL	EQU 9
R9	EQU 9
SP	EQU 10
WP	EQU 13
R11	EQU 11
	DXOP CALL,6
	DXOP RET,7
	DXOP WHEX,10
	DXOP WRITE,12    ;WRITE CHAR IN MSB 
	DXOP	MESG,14
	DXOP DEBUG,15    ;TRACE THE PRECEDING INSTRUCTION, PC,ST and REGISTERS 

;-------- START MODULE -----------
	NAM CC_CL99
;/*
;** CC_CL99.C -- M38d one-shot command-line parser for SMALLC99
;**
;** AORG >A000, overlay ID 7, physical page 12. The implementation is
;** intentionally parallel to CC_CLI, but derives native .A99 output names
;** and identifies the separate TMS-target compiler.
;*/
;#asm
        AORG    0A000H
;#define YES 1
;#define NO  0
;#define NAMEMAX 14
;extern puts();
;extern putchar();
;extern char srcname[];
;extern char outname[];
;extern int verbose;
;extern int mainflg;
;upcase(c)
	EVEN
upcase:
;int c;
;{
;modstk(newsp,save)
;    if(c >= 'a') {
;modstk(newsp,save)
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,97
;_ccge
	C R3,R4 ;optimised
	JGT $+8
	JEQ $+6
	B @cc2
;        if(c <= 'z') return c - 32;
;modstk(newsp,save)
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,122
;_ccle
	C R3,R4 ;optimised
	JLT $+8
	JEQ $+6
	B @cc3
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
;const2(val)
	LI R3,-32
;	zadd()
	A R3,R4
;modstk(newsp,save)
	RET
;    }
cc3:
;modstk(newsp,save)
;    return c;
cc2:
;getloc(sym, off)
	MOV @2(SP),R4 ;optimised load
;modstk(newsp,save)
	RET
;}
;/*  Names stop at any control character, not just NUL.  A command line
;    handed over by the procedure engine still carries its CR, and
;    _setargs splits on SPACE only, so the last token arrives as
;    "MAIN2\r" and appendext then builds "MAIN2\r.C".  */
;copyname(dst, src)
	EVEN
copyname:
;char *dst;
;char *src;
;{
;    int n;
;    n = 0;
;modstk(newsp,save)
	DECT SP
	CLR R4
;puttos()
	MOV R4,*SP
;    while(*src > ' ') {
cc5:
;getloc(sym, off)
	MOV @4(SP),R4 ;optimised load
;indirect ccgchar
	MOVB *R4,R4
	SRA R4,8
	MOV R4,R3 ;optimised push/pop
	LI R4,32
;_ccgt
	C R3,R4 ;optimised
	JGT $+6
	B @cc6
;        if(n >= NAMEMAX) {
;modstk(newsp,save)
;getloc(sym, off)
	MOV *SP,R4 ;optimised load
	MOV R4,R3 ;optimised push/pop
	LI R4,14
;_ccge
	C R3,R4 ;optimised
	JGT $+8
	JEQ $+6
	B @cc7
;            dst[NAMEMAX] = 0;
;modstk(newsp,save)
;getloc(sym, off)
	MOV @6(SP),R4 ;optimised load
;const2(val)
	LI R3,14
;	zadd()
	A R3,R4
	MOV R4,R3 ;optimised push/pop
	CLR R4
;putstk - char
	MOVB @2*R4+1(WP),*R3
;            return NO;
	CLR R4
;modstk(newsp,save)
	INCT SP
	RET
;        }
;        dst[n++] = upcase(*src++);
cc7:
;getloc(sym, off)
	MOV @6(SP),R4 ;optimised load
	DECT SP
	MOV R4,*SP
;getloc(sym, off)
	LI R4,2
	A SP,R4
	MOV R4,R5 ;optimised expr save
;indirect ccgint
	MOV *R4,R4
;inc()
	INC R4
	MOV R5,R3 ;optimised expr restore
;putstk - int
	MOV R4,*R3
;	dec()
	DEC R4
;scale(type,tag)
	MOV *SP+,R3
;	zadd()
	A R3,R4
	DECT SP
	MOV R4,*SP
;getloc(sym, off)
	LI R4,6
	A SP,R4
	MOV R4,R5 ;optimised expr save
;indirect ccgint
	MOV *R4,R4
;inc()
	INC R4
	MOV R5,R3 ;optimised expr restore
;putstk - int
	MOV R4,*R3
;	dec()
	DEC R4
;indirect ccgchar
	MOVB *R4,R4
	SRA R4,8
	DECT SP
	MOV R4,*SP
;zcall()
	CALL @upcase
;modstk(newsp,save)
	INCT SP
	MOV *SP+,R3
;putstk - char
	MOVB @2*R4+1(WP),*R3
;    }
;modstk(newsp,save)
;jump(label)
	B @cc5
cc6:
;    dst[n] = 0;
;getloc(sym, off)
	MOV @6(SP),R4 ;optimised load
	MOV R4,R5 ;optimised expr save
;getloc(sym, off)
	MOV *SP,R4 ;optimised load/expr
;scale(type,tag)
	MOV R5,R3 ;optimised expr restore
;	zadd()
	A R3,R4
	MOV R4,R3 ;optimised push/pop
	CLR R4
;putstk - char
	MOVB @2*R4+1(WP),*R3
;    return YES;
	LI R4,1
;modstk(newsp,save)
	INCT SP
	RET
;}
